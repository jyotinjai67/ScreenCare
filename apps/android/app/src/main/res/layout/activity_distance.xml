<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <!-- TextureView preview container -->
    <TextureView
        android:id="@+id/texturePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay guidance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#CC0B0F19">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viewing Distance Estimator"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Local on-device measurement only. Zero images stored or uploaded."
            android:textSize="12sp"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- Bottom distance feedback -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#EE0F172A">

        <TextView
            android:id="@+id/tvDistanceCm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Measuring: ~55 cm"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#34D399" />

        <TextView
            android:id="@+id/tvDistanceFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Optimal distance: Sit back comfortably with shoulders relaxed."
            android:textSize="14sp"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/btnCloseDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0284C7"
            android:text="Close &amp; Release Camera"
            android:textAllCaps="false" />
    </LinearLayout>
</RelativeLayout>
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./apps/desktop/node_modules/@types"
    ]
  },
  "include": [
    "shared/**/*",
    "tests/**/*"
  ]
}
